	"exports": {
		".": "./x/index.js",
		"./maybe": "./x/maybe/index.js"
	},
	"files": [
		"x",
		"s"
	],
	"scripts": {
		"build": "rm -rf x && mkdir x && tsc",
		"dev": "octo 'tsc -w' 'node --watch x/tests.test.js'",
